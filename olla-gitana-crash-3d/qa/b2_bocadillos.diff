+  /* Retrato simple del hablante: figura de 56px en la esquina superior
+     izquierda del bocadillo. Sin arte complejo: cara reconocible por color. */
+  _drawPortrait(g, cfg, cx, cy, r, tone) {
+    g.save();
+    g.beginPath();
+    if (cfg.shape === 'square') roundRect(g, cx - r, cy - r, r * 2, r * 2, 12);
+    else g.arc(cx, cy, r, 0, Math.PI * 2);
+    g.fillStyle = cfg.bg;
+    g.fill();
+    g.lineWidth = 5;
+    g.strokeStyle = tone.stroke;
+    g.stroke();
+    g.clip();
+
+    const ex = r * 0.42;                       // separación de los ojos
+    // ojos (con brillo)
+    for (const sx of [-1, 1]) {
+      g.beginPath();
+      g.arc(cx + sx * ex, cy - r * 0.16, r * 0.3, 0, Math.PI * 2);
+      g.fillStyle = cfg.eye;
+      g.fill();
+      g.beginPath();
+      g.arc(cx + sx * ex - r * 0.1, cy - r * 0.28, r * 0.11, 0, Math.PI * 2);
+      g.fillStyle = 'rgba(255,255,255,0.95)';
+      g.fill();
+    }
+    // rasgos extra
+    if (cfg.hat === 'squares') {               // cacharro: boca chunga
+      g.lineWidth = 4; g.strokeStyle = cfg.eye;
+      g.beginPath(); g.moveTo(cx - r * 0.45, cy + r * 0.05); g.lineTo(cx + r * 0.45, cy + r * 0.05); g.stroke();
+      g.beginPath(); g.moveTo(cx - r * 0.18, cy + r * 0.45); g.lineTo(cx + r * 0.18, cy + r * 0.45); g.stroke();
+    } else if (cfg.hat === 'mustache') {        // fermín: bigote
+      g.beginPath(); g.ellipse(cx, cy + r * 0.34, r * 0.42, r * 0.16, 0, 0, Math.PI * 2);
+      g.fillStyle = cfg.eye; g.fill();
+    } else {                                    // olla: sonrisa amplia
+      g.lineWidth = 4; g.strokeStyle = cfg.eye;
+      g.beginPath(); g.arc(cx, cy + r * 0.28, r * 0.3, 0.15 * Math.PI, 0.85 * Math.PI); g.stroke();
+    }
+    g.restore();
+
+    // asa/tapa de la olla por encima del clip (siempre dentro del bocadillo)
+    if (cfg.hat === 'lid') {
+      g.save();
+      g.lineWidth = 5; g.strokeStyle = cfg.acc;
+      g.beginPath();
+      g.arc(cx, cy - r * 0.95, r * 0.45, Math.PI * 1.15, Math.PI * 1.85);
+      g.stroke();
+      g.restore();
+    }
+  }
 }
 
